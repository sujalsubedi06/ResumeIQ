# ResumeIQ Backend — Environment Variables
# Copy this file to .env and adjust for your environment.

# CORS: Comma-separated origins allowed. Use "*" for development.
# Production: https://resumeiq.sujalsubedi.name.np
CORS_ORIGINS="http://localhost:3000"

# Server host & port (used by start.sh)
HOST=0.0.0.0
PORT=8000

# Gunicorn worker count
GUNICORN_WORKERS=2
